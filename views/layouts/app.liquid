<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {% if apiKey %}<meta name="shopify-api-key" content="{{ apiKey }}" />{% endif %}
  <title>Photoshoot Diagnostic{% if product %} — {{ product.title }}{% endif %}</title>
  <link rel="stylesheet" href="/public/css/app.css" />
</head>
<body>
  <div class="app-shell">
    {% render '_nav', active_page: active_page, shop: shop %}
    <main class="app-main">
      {{ content_for_layout }}
    </main>
  </div>

  {% if host %}
  <!-- App Bridge v3: auto-initializes from the shopify-api-key meta tag + host URL param -->
  <script src="https://cdn.shopify.com/shopifycloud/app-bridge.js"
          data-api-key="{{ apiKey }}"></script>
  {% endif %}

  <script>
    (function() {
      var u = new URL(window.location.href);
      var token = u.searchParams.get('token');
      if (!token) return;
      document.addEventListener('click', function(e) {
        var a = e.target.closest('a[href^="/app"]');
        if (!a || a.target === '_blank') return;
        var href = a.getAttribute('href');
        if (!href || href.indexOf('token=') !== -1) return;
        e.preventDefault();
        var next = new URL(href, window.location.origin);
        next.searchParams.set('token', token);
        window.location.href = next.pathname + '?' + next.searchParams.toString();
      }, true);
    })();
  </script>
  <script src="/public/js/dashboard.js" defer></script>
  {% if page_script == 'product-detail' %}
  <script src="/public/js/product-detail.js" defer></script>
  {% endif %}
</body>
</html>
